{
  "id": "./",
  "name": "Play Pass Browser",
  "short_name": "Play Pass",
  "description": "Every game in Google Play Pass, with screenshots, trailers and ratings; searchable, filterable and in eight languages.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#edf0f6",
  "theme_color": "#edf0f6",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Discover", "url": "./#discover=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Favourites", "url": "./#favs=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
